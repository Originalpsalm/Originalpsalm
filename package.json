{
  "name": "guru",
  "version": "1.0.0",
  "private": true,
  "description": "GURU \u2014 past questions, study groups and exam prep for Nigerian secondary students (WAEC, JAMB, NECO).",
  "scripts": {
    "dev": "node scripts/setup-env.mjs && next dev",
    "build": "next build",
    "start": "node scripts/setup-env.mjs && node scripts/seed.mjs --if-empty && next start",
    "seed": "node scripts/setup-env.mjs && node scripts/seed.mjs --demo",
    "reset-db": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\" && npm run seed",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Originalpsalm/Originalpsalm.git"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
