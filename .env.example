# ---------------------------------------------------------------
# GURU — environment configuration
# Copy this file to `.env.local` and fill in real values.
# ---------------------------------------------------------------

# Secret used to sign session cookies (JWT). MUST be changed in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=dev-secret-change-me-in-production-please-0123456789

# Where the SQLite database file lives.
DATABASE_PATH=./data/guru.db

# --- Subscription -----------------------------------------------
# Price of GURU Premium, in naira, per month.
PREMIUM_PRICE_NAIRA=2000

# --- Anti account-sharing ---------------------------------------
# How many devices may be signed in to one account AT THE SAME TIME.
MAX_CONCURRENT_SESSIONS=1
# How many DISTINCT devices an account may use within the rolling window below.
MAX_DEVICES_PER_WINDOW=3
DEVICE_WINDOW_DAYS=30

# --- Paystack ---------------------------------------------------
# Leave both blank to run payments in MOCK mode (the full subscription
# flow works end-to-end without charging anyone — useful for testing).
# Get real keys at https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Public base URL, used to build the Paystack callback link.
NEXT_PUBLIC_APP_URL=http://localhost:3000
