# Psalm Creations Business Suite — environment template
# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL — pooled URL used by the application at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/psalm_creations"

# PostgreSQL — direct (non-pooled) URL used by Prisma migrations only.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/psalm_creations"

# Signing secret for session JWTs (ADR-0002). Generate: openssl rand -base64 48
JWT_SECRET=""

# Email (password reset). Configured when the auth email flow lands.
EMAIL_SERVER=""
SMTP_USER=""
SMTP_PASSWORD=""

# Object storage (expense attachments — Phase 3).
STORAGE_KEY=""
